# ── Supabase ─────────────────────────────────────────────────────────────────
# Public values (safe to expose to the browser) — used by the anon shopper app
# and the admin client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. NEVER expose to the browser. Used for the seed script and
# admin-privileged operations (e.g. creating admin users). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL used to build store QR codes (e.g. http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
